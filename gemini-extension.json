      "pencil:batch_design",
      "pencil:snapshot_layout",
      "pencil:get_screenshot",
      "pencil:get_variables",
      "pencil:set_variables",
      "pencil:find_empty_space_on_canvas",
      "pencil:search_all_unique_properties",
      "pencil:replace_all_matching_properties",
      "pencil:export_nodes"
